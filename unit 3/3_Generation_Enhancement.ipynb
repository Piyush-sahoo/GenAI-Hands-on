     "output_type": "stream",
     "text": [
      "Linear Quantization Demo (FP32 → INT8 → FP32)\n",
      "=================================================================\n",
      "Scale factor S = 0.007111\n",
      "Zero point   Z = -95\n",
      "\n",
      "Index    FP32         INT8       Reconstructed    Error\n",
